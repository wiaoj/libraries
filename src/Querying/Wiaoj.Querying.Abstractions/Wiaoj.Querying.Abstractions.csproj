<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!--
      The types here are the query language itself — the request, its nodes, its parsers and its validation
      result — so they keep the root namespace. A contract assembly writes `using Wiaoj.Querying;` and gets
      QueryRequest without taking dependency injection, options or an expression engine along with it.
    -->
    <RootNamespace>Wiaoj.Querying</RootNamespace>
    <AssemblyName>Wiaoj.Querying.Abstractions</AssemblyName>
    <PackageId>Wiaoj.Querying.Abstractions</PackageId>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Extensions\Primitives\Wiaoj.Primitives\Wiaoj.Primitives.csproj" />
  </ItemGroup>

</Project>
