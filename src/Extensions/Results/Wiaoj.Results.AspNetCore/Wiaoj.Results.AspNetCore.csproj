<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>

	  <RootNamespace>Wiaoj.Results.AspNetCore</RootNamespace>
	  <AssemblyName>Wiaoj.Results.AspNetCore</AssemblyName>
	  <PackageId>Wiaoj.Results.AspNetCore</PackageId>

	  <Title>Wiaoj Results - Robust Error Handling Pattern</Title>
	  <Description>A high-performance, zero-dependency implementation of the Result Pattern for .NET. Replaces exceptions with a type-safe, functional approach (Railway Oriented Programming) using lightweight structs. Perfect for Domain-Driven Design (DDD) and Clean Architecture.</Description>
	  <PackageTags>result;error-handling;functional;railway-oriented-programming;rop;monad;clean-architecture;ddd;zero-allocation;performance</PackageTags>



	  <!-- Build & Pack Settings -->
	  <GeneratePackageOnBuild Condition="'$(Configuration)' == 'Release'">true</GeneratePackageOnBuild>
	  <IsPackable>true</IsPackable>

	  <!-- API break detection against the last published version -->
	  <EnablePackageValidation>true</EnablePackageValidation>
	  <PackageValidationBaselineVersion>0.3.0-alpha.1</PackageValidationBaselineVersion>

	  <!-- Optimization & AOT -->
	  <IsAotCompatible>true</IsAotCompatible>
	  <IsTrimmable>true</IsTrimmable>

	  <!-- Analysis -->
	  <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
	  <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
	  <EnableAotAnalyzer>true</EnableAotAnalyzer>

	  <!-- Documentation -->
	  <GenerateDocumentationFile>true</GenerateDocumentationFile>
	  <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
	  <DebugType>full</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
	  <DebugType>portable</DebugType>
  </PropertyGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\Wiaoj.Results\Wiaoj.Results.csproj" />
	</ItemGroup>


	<ItemGroup>
		<None Include="..\README.md" Pack="true" PackagePath="\" Condition="Exists('..\README.md')" />
		<None Include="..\CHANGELOG.md" Pack="true" PackagePath="\" Condition="Exists('..\CHANGELOG.md')" />
		<None Include="icon.png" Pack="true" PackagePath="\" Condition="Exists('icon.png')" />
		<None Include="..\..\LICENSE" Pack="true" PackagePath="\" Condition="Exists('..\..\LICENSE')" />
	</ItemGroup>
</Project>
