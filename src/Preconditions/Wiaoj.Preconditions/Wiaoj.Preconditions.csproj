<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>											 
		<TargetFrameworks>net10.0</TargetFrameworks>
		<RootNamespace>Wiaoj.Preconditions</RootNamespace>

		<!-- Package Configuration -->
		<PackageId>Wiaoj.Preconditions</PackageId>
		<Title>Wiaoj Preconditions - High-Performance Guard Clauses</Title>
		<Description>Zero-dependency, high-performance guard clauses for defensive programming in .NET. AOT-Compatible and highly optimized.</Description>
		<PackageTags>guard;defensive-programming;preconditions;validation;performance;zero-dependency;dotnet;aot</PackageTags>

		<!-- Build & Pack Configuration -->
		<GeneratePackageOnBuild Condition="'$(Configuration)' == 'Release'">true</GeneratePackageOnBuild>
		<IsPackable>true</IsPackable>

		<!-- Performance & AOT Compatibility -->
		<!--
			Deliberately not configuration-conditional, unlike the rest of the repository.
			Wiaoj.Primitives.Tests.Unit asserts zero allocations on paths that call these guards,
			and the assertions only hold while the callee assembly is optimised: with Optimize=false
			in Debug the guard IL grows past the inline budget and each Compute() call allocates 32 bytes.
			Removing this line makes 7 tests fail in Debug. See wiaoj/libraries PR for evidence.
		-->
		<Optimize>true</Optimize>
		<IsAotCompatible>true</IsAotCompatible>
		<IsTrimmable>true</IsTrimmable>

		<!-- Analyzer Settings -->
		<EnableTrimAnalyzer>true</EnableTrimAnalyzer>
		<EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
		<EnableAotAnalyzer>true</EnableAotAnalyzer>

		<!-- Documentation -->
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

	<!-- Debug/Release -->
	<PropertyGroup Condition="'$(Configuration)' == 'Debug'">
		<DebugType>full</DebugType>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<DebugType>portable</DebugType>
	</PropertyGroup>

	<!-- Test Visibility -->
	<ItemGroup>
		<InternalsVisibleTo Include="Wiaoj.Preconditions.Tests.Unit" />
		<InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
	</ItemGroup>

	<!-- Files -->
	<ItemGroup>
		<None Include="..\README.md" Pack="true" PackagePath="\" Condition="Exists('..\README.md')" />
		<None Include="CHANGELOG.md" Pack="true" PackagePath="\" Condition="Exists('CHANGELOG.md')" />
		<None Include="icon.png" Pack="true" PackagePath="\" Condition="Exists('icon.png')" />  
		<None Include="..\..\LICENSE" Pack="true" PackagePath="\" Condition="Exists('..\..\LICENSE')" />
	</ItemGroup>

</Project>