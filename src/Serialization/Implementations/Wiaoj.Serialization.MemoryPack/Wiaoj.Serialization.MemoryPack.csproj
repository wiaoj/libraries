<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
	  <PackageId>Wiaoj.Serialization.MemoryPack</PackageId>
	  <Title>Wiaoj Serialization MemoryPack</Title>
	  <Description>MemoryPack implementation for Wiaoj Serialization: compact binary for data exchanged between .NET applications. Types must be [MemoryPackable]; mark them [MemoryPackable(GenerateType.VersionTolerant)] when the data outlives a deployment.</Description>
	  <PackageTags>serialization;memorypack;binary;performance;wiaoj</PackageTags>
	  <IsPackable>true</IsPackable>
	  <GeneratePackageOnBuild Condition="'$(Configuration)' == 'Release'">true</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MemoryPack" />
  </ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\..\Preconditions\Wiaoj.Preconditions\Wiaoj.Preconditions.csproj" />
		<ProjectReference Include="..\..\Core\Wiaoj.Serialization.Abstractions\Wiaoj.Serialization.Abstractions.csproj" />
	</ItemGroup>
</Project>
