<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		
		<RootNamespace>Wiaoj.Serialization</RootNamespace>
		<AssemblyName>Wiaoj.Serialization.Abstractions</AssemblyName>
		
		<PackageId>Wiaoj.Serialization.Abstractions</PackageId>
		<Title>Wiaoj Serialization Abstractions</Title>
		<Description>Core interfaces and abstractions for the Wiaoj Serialization library.</Description>
		<PackageTags>serialization;abstractions;interfaces;json;messagepack;wiaoj</PackageTags>
		<IsPackable>true</IsPackable>
		<GeneratePackageOnBuild Condition="'$(Configuration)' == 'Release'">true</GeneratePackageOnBuild>
	</PropertyGroup>
</Project>