<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<PackageId>Wiaoj.Serialization.Security</PackageId>
		<Version>0.0.1-alpha.1</Version>
		<Authors>wiaoj</Authors>
		<Description>Encrypts what a Wiaoj serializer writes with a Wiaoj.Security key ring: authenticated AES-GCM that follows key rotation.</Description>
		<PackageTags>serialization;security;encryption;aes-gcm;key-rotation;wiaoj</PackageTags>
		<IsPackable>true</IsPackable>
	</PropertyGroup>

