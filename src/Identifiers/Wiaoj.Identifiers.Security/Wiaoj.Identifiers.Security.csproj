<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<EnablePackageValidation>true</EnablePackageValidation>
		<PackageValidationBaselineVersion>0.3.0-alpha.1</PackageValidationBaselineVersion>
		<TargetFramework>net10.0</TargetFramework>
		<RootNamespace>Wiaoj.Identifiers.Security</RootNamespace>
		<AssemblyName>Wiaoj.Identifiers.Security</AssemblyName>
		<PackageId>Wiaoj.Identifiers.Security</PackageId>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<IsAotCompatible>true</IsAotCompatible>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<!-- PrivateAssets="none": a project referencing only this package still gets the source generator. -->
		<ProjectReference Include="..\Wiaoj.Identifiers\Wiaoj.Identifiers.csproj" PrivateAssets="none" />
		<ProjectReference Include="..\..\Extensions\Security\Wiaoj.Security.Abstractions\Wiaoj.Security.Abstractions.csproj" />
	</ItemGroup>

</Project>
